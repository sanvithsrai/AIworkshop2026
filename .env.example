# Sahyadri Placement Hub (SPACE) - Environment Variables Template
PORT=5000
NODE_ENV=development

# JWT Secret for Authentication
JWT_SECRET=sahyadri_placement_jwt_secret_2026

# Optional: Cloud Database (PostgreSQL / Supabase)
# If omitted, the server automatically defaults to the high-performance local relational engine (server/data/db.json)
DATABASE_URL=postgresql://postgres:password@localhost:5432/sahyadri_placement
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_secret_key

# Optional: AI & Live Integrations
GEMINI_API_KEY=your_gemini_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
NEWSDATA_API_KEY=your_newsdata_api_key
NEWS_API_KEY=your_newsdata_api_key
