# Sahyadri Placement Hub - Server Environment Variables Template

PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# PostgreSQL Connection (Optional: if not provided, embedded high-performance relational engine is used)
DATABASE_URL=postgresql://postgres:password@localhost:5432/placement_portal
DATABASE_SSL=false

# Supabase Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_secret_key

# Google Gemini API (for Placement Chatbot & Career Guidance)
GEMINI_API_KEY=your_gemini_api_key

# ElevenLabs Voice API (for High-Quality Speech Synthesis & Voice Agent)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# NewsData.io API (for Live Hackathons & Tech Events Feeds)
NEWS_API_KEY=your_newsdata_api_key
